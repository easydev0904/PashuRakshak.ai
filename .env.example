# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=pashurakshak
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=pashurakshak
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full connection string used by the backend (SQLAlchemy / Alembic).
DATABASE_URL=postgresql+psycopg://pashurakshak:change_me_dev_password@localhost:5432/pashurakshak

# ---------------------------------------------------------------------------
# Backend / API
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Local file storage (swappable for S3-compatible storage later).
UPLOAD_STORAGE_BACKEND=local
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=5

# ---------------------------------------------------------------------------
# ML / Risk engine
# ---------------------------------------------------------------------------
MODEL_ARTIFACT_PATH=./ml/models/risk_model.joblib
MODEL_VERSION=prototype-v1

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
